{
  "version": 3,
  "rules": {
    "allow": [
      { "match": "git *", "reason": "git 版本控制" },
      { "match": "git", "reason": "git 版本控制" },
      { "match": "npm *", "reason": "npm" },
      { "match": "pnpm *", "reason": "pnpm" },
      { "match": "yarn *", "reason": "yarn" },
      { "match": "bun *", "reason": "bun" },
      { "match": "pip *", "reason": "pip" },
      { "match": "pip3 *", "reason": "pip" },
      { "match": "python *", "reason": "python" },
      { "match": "python3 *", "reason": "python" },
      { "match": "pytest *", "reason": "pytest" },
      { "match": "cargo *", "reason": "cargo" },
      { "match": "go *", "reason": "go" },
      { "match": "node *", "reason": "node" },
      { "match": "deno *", "reason": "deno" },
      { "match": "tsc *", "reason": "tsc" },
      { "match": "ruff *", "reason": "ruff" },
      { "match": "flake8 *", "reason": "flake8" },
      { "match": "black *", "reason": "black" },
      { "match": "mypy *", "reason": "mypy" },
      { "match": "ls *", "reason": "ls" },
      { "match": "pwd", "reason": "pwd" },
      { "match": "which *", "reason": "which" },
      { "match": "echo *", "reason": "echo" },
      { "match": "cat *", "reason": "cat" },
      { "match": "head *", "reason": "head" },
      { "match": "tail *", "reason": "tail" },
      { "match": "wc *", "reason": "wc" },
      { "match": "sort *", "reason": "sort" },
      { "match": "uniq *", "reason": "uniq" },
      { "match": "find *", "reason": "find" },
      { "match": "grep *", "reason": "grep" },
      { "match": "rg *", "reason": "rg" },
      { "match": "sed *", "reason": "sed" },
      { "match": "awk *", "reason": "awk" },
      { "match": "curl *", "reason": "curl" },
      { "match": "wget *", "reason": "wget" },
      { "match": "make *", "reason": "make" },
      { "match": "cmake *", "reason": "cmake" },
      { "match": "ctest *", "reason": "ctest" },
      { "match": "tar *", "reason": "tar" },
      { "match": "zip *", "reason": "zip" },
      { "match": "unzip *", "reason": "unzip" },
      { "match": "gzip *", "reason": "gzip" },
      { "match": "touch *", "reason": "touch" },
      { "match": "mkdir *", "reason": "mkdir" },
      { "match": "cp *", "reason": "cp" },
      { "match": "mv *", "reason": "mv" },
      { "match": "docker *", "reason": "docker" },
      { "match": "docker-compose *", "reason": "docker-compose" },
      { "match": "ssh google-vps*", "reason": "VPS" },
      { "match": "ssh beihang*", "reason": "计算服务器" },
      { "match": "rm *", "reason": "当前项目内自由删除", "priority": 100 }
    ],
    "deny": [
      { "match": "rm -rf /", "reason": "根目录毁灭性删除" },
      { "match": "rm -rf ~", "reason": "家目录毁灭性删除" },
      { "match": "rm -rf $HOME", "reason": "家目录毁灭性删除" },
      { "match": "rm -rf ..", "reason": "上级目录毁灭性删除" },
      { "match": "mkfs.*", "reason": "磁盘格式化" },
      { "match": "dd if=* of=/dev/*", "reason": "裸设备写入" },
      { "match": "chmod -R 777 /", "reason": "根目录权限破坏" },
      { "match": "shutdown*", "reason": "系统关机" },
      { "match": "reboot", "reason": "系统重启" },
      { "match": "init 0", "reason": "系统关机" }
    ],
    "review": []
  }
}
